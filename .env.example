DATABASE_URL="postgresql://tessa:tessa@localhost:5434/tessa_local?schema=public"
DATABASE_URL_UNPOOLED="postgresql://tessa:tessa@localhost:5434/tessa_local?schema=public"
JWT_SECRET="change-me-min-16-chars"
MASTER_SETUP_KEY="change-me-min-8"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token"
ASSET_MAX_UPLOAD_BYTES="4194304"
# Tradução automática (pt-BR -> en, es)
OPENAI_API_KEY="sk-..."
OPENAI_TRANSLATION_MODEL="gpt-5.4-nano"
TRANSLATION_ENABLED="true"
# Segredo usado para autenticar o worker/cron de tradução (Authorization: Bearer ...)
TRANSLATION_WORKER_SECRET="change-me-translation-worker"
# A Vercel injeta este valor automaticamente nas chamadas de Cron quando configurado
CRON_SECRET="change-me-cron-secret"
# E-mail: preferência Resend; SMTP opcional como fallback
RESEND_API_KEY="re_xxxxxxxx"
# Notificações de contato via SMTP (587 = STARTTLS; 465 = TLS implícito)
SMTP_HOST="smtp.runket.com.br"
SMTP_PORT="587"
SMTP_USER="noreplytessa@runket.com.br"
SMTP_PASSWORD="change-me"
CONTACT_NOTIFICATION_EMAIL="contato.tessa.estruturas@gmail.com"
CONTACT_EMAIL_FROM="Tessa Site <onboarding@resend.dev>"
# Instagram API with Facebook Login for Business (Meta App Dashboard)
INSTAGRAM_APP_ID="your-instagram-app-id"
INSTAGRAM_APP_SECRET="your-instagram-app-secret"
INSTAGRAM_REDIRECT_URI="https://api.example.com/api/instagram/oauth/callback"
# Informe quando o usuário administrar mais de uma Página elegível
INSTAGRAM_FACEBOOK_PAGE_ID="your-facebook-page-id"
# Chave AES-256 (>= 32 chars) para criptografar o access token em repouso
INSTAGRAM_TOKEN_ENCRYPTION_KEY="change-me-instagram-token-encryption-key-32+"
# Mantenha false em produção até a autorização da Meta
INSTAGRAM_CONTENT_ENABLED="false"
# URL do painel admin para redirecionar após o OAuth
ADMIN_APP_URL="http://localhost:5173"
# Avaliações do Google (Business Profile API).
# auto = usa "live" quando as credenciais existem, senão "stub" fora de produção.
# Force com live | stub | off.
GOOGLE_REVIEWS_MODE="auto"
# Credenciais OAuth 2.0 (scope https://www.googleapis.com/auth/business.manage).
# A tela de consentimento precisa estar publicada ("In production") para o
# refresh token não expirar em 7 dias.
GOOGLE_OAUTH_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_OAUTH_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_OAUTH_REFRESH_TOKEN="your-google-oauth-refresh-token"
# Identificadores do local no Business Profile (accounts/{id} e locations/{id}).
GOOGLE_BUSINESS_ACCOUNT_ID="your-account-id"
GOOGLE_BUSINESS_LOCATION_ID="your-location-id"
